# Games belong in local installations, never in source control.
/games/
/installer/games/*
!/installer/games/lone-echo/
!/installer/games/lone-echo-2/
/installer/games/lone-echo/*
/installer/games/lone-echo-2/*
!/installer/games/lone-echo/.gitkeep
!/installer/games/lone-echo-2/.gitkeep

