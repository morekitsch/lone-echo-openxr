# Local game installations, experimental copies, and diagnostics.
/originals/
/working/
/reports/
/runtime/target/
/installer/state/
/installer/userdata/
/installer/payload/
/installer/licenses/
/installer/windows-python/
/installer/setup.exe
/installer/windows-bundle.json
/dist/
